# Direct A2A commands default to this local agent URL when unset.
A2A_AGENT_URL=http://127.0.0.1:9999

# The URL written into the Agent Card. Keep it reachable from A2A clients.
A2A_PUBLIC_URL=http://127.0.0.1:9999

# The default planner is deterministic and needs no API key.
PACKING_PLANNER=deterministic

# Required only when PACKING_PLANNER=openai or --planner openai is selected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
